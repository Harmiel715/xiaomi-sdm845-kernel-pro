# Droidspaces kernel configuration fragment
# Adapted for Linux 4.9 (SDM845 / equuleus)
# Based on: https://github.com/ravindu644/Droidspaces
#
# NOTE: Some options from the upstream guide are omitted because they don't
# exist in 4.9: FW_LOADER_COMPRESS, NETFILTER_XT_TARGET_MASQUERADE,
# NETFILTER_XT_TARGET_REJECT, IP_NF_TARGET_ULOG, ANDROID_PARANOID_NETWORK.
# NF_CONNTRACK_NETLINK is named NF_CT_NETLINK in 4.9.

# ============================================================
# Mandatory: IPC mechanisms
# ============================================================
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ============================================================
# Mandatory: Core namespace support
# (CONFIG_NAMESPACES is already in mi845_defconfig)
# ============================================================
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# ============================================================
# Mandatory: Seccomp support
# (CONFIG_SECCOMP is already in mi845_defconfig)
# ============================================================
CONFIG_SECCOMP_FILTER=y

# ============================================================
# Mandatory: Control groups support
# (CONFIG_CGROUPS is auto-enabled by dependencies)
# ============================================================
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# ============================================================
# Mandatory: Device filesystem support
# ============================================================
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ============================================================
# Mandatory: Overlay filesystem (volatile mode)
# (CONFIG_OVERLAY_FS is already in mi845_defconfig)
# ============================================================

# ============================================================
# Mandatory: TMPFS xattr/ACL (for NixOS support)
# ============================================================
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ============================================================
# Mandatory: Firmware loading support
# ============================================================
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y

# ============================================================
# Mandatory: Droidspaces Network Isolation (NAT/none modes)
# (CONFIG_NETFILTER is already in mi845_defconfig)
# ============================================================
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Legacy IPv4 NAT compat (4.9)
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# ============================================================
# Optional: UFW / Fail2ban firewall support
# ============================================================
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
