# Virtio subsystem — paravirtualized drivers for DroidSpaces containers / KVM
# ARM64 MMIO transport (no PCI on mobile SoCs)
# Reference: https://docs.oasis-open.org/virtio/virtio/v1.3/virtio-v1.3.html
#
# All drivers listed explicitly so no option is silently missed.
# Depends on: CONFIG_BLOCK, CONFIG_NET, CONFIG_INPUT, CONFIG_TTY, CONFIG_DRM
# (these fundamentals are always enabled in mi845_defconfig).

# === Core virtio framework ===
# (VIRTIO_MMIO selects VIRTIO; both listed for clarity)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# === Block device — virtio-disk for containers / VMs ===
CONFIG_VIRTIO_BLK=y

# === Network interface — virtio-net for containers / VMs ===
CONFIG_VIRTIO_NET=y

# === Console — virtio-serial / virtio-console ===
CONFIG_VIRTIO_CONSOLE=y

# === Memory balloon — dynamic memory resize ===
# (selects CONFIG_MEMORY_BALLOON automatically)
CONFIG_VIRTIO_BALLOON=y

# === Input devices — keyboard, mouse, tablet passthrough ===
CONFIG_VIRTIO_INPUT=y

# === GPU — hardware-accelerated rendering via virglrenderer ===
# DRM_VIRTIO_GPU selects DRM_KMS_HELPER + DRM_TTM; all listed explicitly
CONFIG_DRM_TTM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
